---
import PageLayout from '../components/PageLayout.astro';
import ProjectedBracket from '../components/ProjectedBracket.astro';
import { loadLeaguesConfig, loadLeagueStandings } from '../utils/data';
import { projectedSeeds, quarterfinalSummary } from '../utils/projectedBracket';

// Seeds come straight from the final Q3 2026 league standings
const leagueName = 'Q3 2026';
const standings = loadLeagueStandings(leagueName) || [];
const allLeagues = loadLeaguesConfig().leagues;
const league = allLeagues.find((l) => l.name === leagueName) || null;

const pageTitle = `NYC Premodern - ${leagueName} Projected Top 8`;
const pageDescription = quarterfinalSummary(projectedSeeds(standings));
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogUrl="https://league-leaderboard.vercel.app/q3-2026-top-8/"
  currentLeague={league}
>
  <div class="card">
    <header class="page-header">
      <h1>{leagueName} League Championship</h1>
      <p class="subtitle">Projected Top 8 Bracket · seeded by final league points</p>
    </header>

    <ProjectedBracket standings={standings} />
  </div>
</PageLayout>

<style>
  .card {
    padding: 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 1.8rem;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 1rem;
    color: #666;
  }
</style>
